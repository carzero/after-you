{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "after-you",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "durable_objects": {"bindings": [{"name": "RANKINGS", "class_name": "RankingStore"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["RankingStore"]}],
  "observability": {"enabled": true}
}
